{
	"name": "familyos",
	"private": true,
	"description": "FamilyOS: CallumOS + FinnleyOS (first slice of the NATICO platform)",
	"scripts": {
		"dev:family": "wrangler dev --port 8789 --inspector-port 9231 --local-upstream familyos.localhost",
		"dev:callum": "wrangler dev --port 8787 --local-upstream callum.localhost",
		"dev:finnley": "wrangler dev --port 8788 --inspector-port 9230 --local-upstream finnley.localhost",
		"typecheck": "tsc -p .",
		"test": "vitest run",
		"check": "tsc -p . && vitest run && wrangler deploy --dry-run -c ../../wrangler.jsonc"
	}
}
